# Общие настройки сервера. Всё про конкретный вуз — в tenants/<id>/tenant.json.
PORT=8792
HOST=127.0.0.1
# Базы вузов: <DATA_DIR>/<id>.db
DATA_DIR=/home/ubuntu/schedule-server/data
# Сборка сайта (одна на все вузы)
WEB_DIR=/var/www/schedule
# ПИН для /api/refresh (ручная сверка)
ADMIN_PIN=
# Соль для псевдонимов IP в аналитике — длинная случайная строка
IP_SALT=
# Для разработки на localhost: какой вуз показывать
# DEV_TENANT=kfu
