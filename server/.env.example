# Общие настройки сервера. Всё про конкретный вуз — в tenants/<id>/tenant.json.
PORT=8792
HOST=127.0.0.1
# Базы вузов: <DATA_DIR>/<id>.db
DATA_DIR=/home/ubuntu/schedule-server/data
# Сборка сайта (одна на все вузы)
WEB_DIR=/var/www/schedule
# ПИН для /api/refresh (ручная сверка)
ADMIN_PIN=
# Соль для псевдонимов IP в аналитике — длинная случайная строка
IP_SALT=
# Для разработки на localhost: какой вуз показывать
# DEV_TENANT=kfu

# ─── Обсуждения Para (только адрес Para) ───
# Вход через Google: Web-клиент OAuth из Google Cloud Console. Пока пусто — вход «скоро появится».
# Значения вписывает владелец на сервере; в чат и в git они не попадают.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Почты модераторов (подтверждённые Google-аккаунты), через запятую
SOCIAL_ADMIN_EMAILS=
# Длинная случайная строка (openssl rand -hex 32): отпечатки заблокированных аккаунтов после удаления
SOCIAL_SALT=
# on | readonly | off (аварийный выключатель; после правки — systemctl restart schedule-api)
SOCIAL_MODE=on
# С какого возраста можно завести аккаунт (13–18). Публичные тексты должны говорить то же число.
SOCIAL_MIN_AGE=16
# Сколько учитываемых жалоб скрывают публикацию (не тяжёлые причины)
SOCIAL_REPORT_THRESHOLD=3
# Жалобы от аккаунтов моложе стольких часов не учитываются для автоскрытия
SOCIAL_REPORTER_MIN_AGE_H=24
# Фото: по умолчанию <DATA_DIR>/media
# MEDIA_DIR=
# Только для разработки (в production не действуют):
# PARA_ORIGIN=http://be.localhost:8792
# DEV_LOGIN=1
# DEV_HUB=1
# SOCIAL_NEW_ACCOUNT_H=24
# SOCIAL_RATE_LIMITS=off
# SOCIAL_DEV_GOOGLE_TOKEN_URL=http://127.0.0.1:9901/token   (дымовой тест с поддельным Google)
