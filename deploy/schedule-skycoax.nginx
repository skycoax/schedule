# Расписания вузов: любой поддомен *.skycoax.uz → один сервер schedule-api (127.0.0.1:8792).
# Какой вуз показать, сервер решает сам по адресу (server/tenants/<id>/tenant.json),
# поэтому новый вуз не требует правок здесь. Поддомены со своими блоками
# (hg.skycoax.uz и т. п.) по-прежнему обслуживаются ими: точное имя важнее маски.
server {
    listen 80;
    listen [::]:80;
    server_name *.skycoax.uz;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name *.skycoax.uz;

    ssl_certificate /etc/letsencrypt/live/skycoax.uz-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/skycoax.uz-wildcard/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    root /var/www/schedule;
    charset utf-8;

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    gzip on;
    gzip_types application/json text/css application/javascript image/svg+xml;
    gzip_min_length 1024;

    # Сборка сайта (одна на все вузы) — статикой, с долгим кешем: имена файлов с хешем.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Всё остальное — страница с брендом вуза, манифест, картинки бренда и API — сервер.
    location / {
        proxy_pass http://127.0.0.1:8792;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60;
    }

    access_log /var/log/nginx/schedule.access.log;
    error_log  /var/log/nginx/schedule.error.log;
}
