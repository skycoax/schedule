[Unit]
Description=Schedule API — расписания всех вузов (*.skycoax.uz)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/schedule-server
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.2/bin/node --experimental-sqlite src/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
