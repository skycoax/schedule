[Unit]
Description=TSUE Raspisanie API
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tsue-server
ExecStart=/home/ubuntu/.nvm/versions/node/v22.23.2/bin/node --experimental-sqlite src/index.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

[Install]
WantedBy=multi-user.target
