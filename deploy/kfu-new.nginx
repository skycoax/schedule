# Расписание КФУ — новый стек: React-статика + прокси /api на локальный бэкенд.
# Сгенерирован из живого конфига + блок location /api/. SSL-строки certbot сохранены.

server {
    server_name kfu.bestcenter.uz;

    root /var/www/kfu;
    index index.html;

    charset utf-8;

    # API нашего бэкенда (Node на 127.0.0.1:8790). Тот же домен — без CORS.
    location /api/ {
        proxy_pass http://127.0.0.1:8790;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60;
    }

    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # Собранные ассеты Vite версионируются по имени — можно кэшировать надолго.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    location ~* \.(png|webmanifest)$ {
        add_header Cache-Control "public, max-age=2592000";
    }

    location = /manifest.json {
        add_header Cache-Control "public, max-age=86400";
    }

    access_log /var/log/nginx/kfu.access.log;
    error_log  /var/log/nginx/kfu.error.log;

    listen 443 ssl; # managed by Certbot
    listen [::]:443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/kfu.bestcenter.uz/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/kfu.bestcenter.uz/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}


server {
    if ($host = kfu.bestcenter.uz) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    listen [::]:80;
    server_name kfu.bestcenter.uz;
    return 404; # managed by Certbot


}
